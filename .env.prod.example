# Production environment for docker-compose.prod.yml on the EC2 host.
# The real .env lives only on the server (/opt/codinghubs/.env), written by
# the deploy script from AWS SSM Parameter Store — never committed.

SECRET_KEY=replace-with-long-random-secret
# Google sign-in: OAuth client ids (from Google Cloud Console), comma separated.
GOOGLE_CLIENT_IDS=replace-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-domain.example
SECURE_SSL_REDIRECT=False

POSTGRES_DB=codinghubs
POSTGRES_USER=codinghubs
POSTGRES_PASSWORD=replace-me

RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

VITE_RAZORPAY_KEY_ID=
DOMAIN=_

# AI features: add as SSM parameters /codinghubs/prod/GEMINI_API_KEY (and GROQ_API_KEY); optional tuning vars are listed in backend/.env.example
GEMINI_API_KEY=replace-me
GROQ_API_KEY=replace-me

# Interview Studio; server-only secrets, never VITE_ variables
STUDIO_AI_KEY=replace-me
STUDIO_AI_MODEL=
STUDIO_EXECUTION_ENABLED=False
STUDIO_PYTHON_IMAGE=python:3.12-alpine
STUDIO_NODE_IMAGE=node:22-alpine

# Newsletter: set these only after verifying your existing SMTP account and sender.
NEWSLETTER_EMAIL_ENABLED=False
NEWSLETTER_CONFIRM_TTL=172800
NEWSLETTER_UNSUBSCRIBE_TTL=31536000
EMAIL_TIMEOUT=15
BROCHURE_MAX_BYTES=10485760
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=replace-with-verified-sender@example.invalid

# Job importer (manage.py import_jobs / jobs-worker). Greenhouse, Lever, Remotive and Arbeitnow need no key.
# Adzuna (free key: developer.adzuna.com) and Jooble (free key: jooble.org/api/about) switch on once these are set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# JOBS_AUTO_PUBLISH=True          # False: imported jobs wait in the admin panel for approval
# JOBS_SEARCH_TERMS=python developer,data analyst,machine learning,software engineer intern,full stack developer
# ADZUNA_WHERE=Delhi
# JOOBLE_LOCATION=Delhi

# Production environment for docker-compose.prod.yml on the EC2 host.
# The real .env lives only on the server (/opt/codinghubs/.env), written by
# the deploy script from AWS SSM Parameter Store — never committed.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-domain.example
SECURE_SSL_REDIRECT=False

POSTGRES_DB=codinghubs
POSTGRES_USER=codinghubs
POSTGRES_PASSWORD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

VITE_RAZORPAY_KEY_ID=
DOMAIN=_

# AI features: add as SSM parameters /codinghubs/prod/GEMINI_API_KEY (and GROQ_API_KEY); optional tuning vars are listed in backend/.env.example
GEMINI_API_KEY=
GROQ_API_KEY=

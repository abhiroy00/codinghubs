# Backend API root. Leave as /api behind the site's nginx (or the Vite dev proxy).
VITE_API_BASE_URL=/api
# TinyMCE Cloud API key (https://www.tiny.cloud/). It is a client-side key, NOT a secret: in the Tiny dashboard restrict it
# to https://codinghubs.in and https://admin.codinghubs.in. Empty = the editor falls back to a plain HTML box.
VITE_TINYMCE_API_KEY=

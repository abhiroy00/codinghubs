SECRET_KEY=change-me-to-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Blog / case studies
SITE_URL=https://codinghubs.in
MEDIA_ROOT=/app/media
# Internal URL the backend fetches the built app shell from (docker-compose sets it); leave empty in local dev
FRONTEND_SHELL_URL=

# Store: private files (outside MEDIA_ROOT, never served by nginx), expiring links, unpaid-order hold time
PRIVATE_MEDIA_ROOT=/app/private_media
STORE_DOWNLOAD_LINK_TTL=600
STORE_PENDING_ORDER_MINUTES=30
# Razorpay: use rzp_test_ keys until you are ready to take real payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Order e-mails (console backend prints them; use SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Coding Hubs <no-reply@codinghubs.in>

# --- AI features (Gemini primary, Groq optional fallback; free tiers have quotas) ---
# Get keys at https://aistudio.google.com/apikey and https://console.groq.com/keys. Never commit real keys.
# Run `python manage.py ai_check` after setting them to confirm the keys and model names work.
GEMINI_API_KEY=
# Several models can be listed, comma separated; they are tried in order, then the next provider.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER_ORDER=gemini,groq
AI_REQUEST_TIMEOUT=20
AI_TOTAL_BUDGET=45
AI_MAX_RETRIES=1
AI_DAILY_LIMIT_PER_USER=30
AI_GLOBAL_DAILY_LIMIT=1000

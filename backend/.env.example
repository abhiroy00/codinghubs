SECRET_KEY=replace-with-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Blog / case studies
SITE_URL=https://codinghubs.in
MEDIA_ROOT=/app/media
# Internal URL the backend fetches the built app shell from (docker-compose sets it); leave empty in local dev
FRONTEND_SHELL_URL=

# Store: private files (outside MEDIA_ROOT, never served by nginx), expiring links, unpaid-order hold time
PRIVATE_MEDIA_ROOT=/app/private_media
STORE_DOWNLOAD_LINK_TTL=600
STORE_PENDING_ORDER_MINUTES=30
# Razorpay: use rzp_test_ keys until you are ready to take real payments.
# Set both keys or neither; a half-configured pair fails the production check.
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
# Order e-mails (console backend prints them; use SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Coding Hubs <no-reply@codinghubs.in>

# --- AI features (Gemini primary, Groq optional fallback; free tiers have quotas) ---
# Get keys at https://aistudio.google.com/apikey and https://console.groq.com/keys. Never commit real keys.
# Run `python manage.py ai_check` after setting them to confirm the keys and model names work.
GEMINI_API_KEY=replace-me
# Several models can be listed, comma separated; they are tried in order, then the next provider.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER_ORDER=gemini,groq
AI_REQUEST_TIMEOUT=20
AI_TOTAL_BUDGET=45
AI_MAX_RETRIES=1
AI_DAILY_LIMIT_PER_USER=30
AI_GLOBAL_DAILY_LIMIT=1000

# Keep the staged gigs marketplace off until moderation and launch policies are ready.
GIGS_ENABLED=False

# Interview Studio (server-only; choose a model supporting Responses structured outputs)
STUDIO_AI_KEY=replace-me
STUDIO_AI_MODEL=
STUDIO_AI_URL=https://api.openai.com/v1/responses
# Enable only after deploying the isolated worker on a dedicated Docker host.
STUDIO_EXECUTION_ENABLED=False
# Pin reviewed runtime images by digest in production; pre-pull on runner host.
STUDIO_PYTHON_IMAGE=python:3.12-alpine
STUDIO_NODE_IMAGE=node:22-alpine

DEBUG=True

# Google Identity Services: Web application OAuth client ID(s), comma separated.
# The first ID is used by the web sign-in button. No client secret is needed.
GOOGLE_CLIENT_IDS=replace-me

# Newsletter SMTP adapter (use an authorized sender; keep disabled until reviewed).
NEWSLETTER_EMAIL_ENABLED=False
NEWSLETTER_CONFIRM_TTL=172800
NEWSLETTER_UNSUBSCRIBE_TTL=31536000
EMAIL_TIMEOUT=15
# Maximum PDF brochure size; persistent PRIVATE_MEDIA_ROOT is already configured above.
BROCHURE_MAX_BYTES=10485760

# Job importer (manage.py import_jobs / jobs-worker). Greenhouse, Lever, Remotive and Arbeitnow need no key.
# Adzuna (free key: developer.adzuna.com) and Jooble (free key: jooble.org/api/about) switch on once these are set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# JOBS_AUTO_PUBLISH=True          # False: imported jobs wait in the admin panel for approval
# JOBS_SEARCH_TERMS=python developer,data analyst,machine learning,software engineer intern,full stack developer
# ADZUNA_WHERE=Delhi
# JOOBLE_LOCATION=Delhi

{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run genai:sync && npm run roadmap:sync && npm run interview:sync",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate:locations": "node scripts/validate-locations.mjs",
    "validate:seo": "node --test scripts/seo-html.test.mjs && node scripts/validate-seo.mjs && node scripts/validate-genai-seo.mjs",
    "validate": "npm run interview:check && npm run prep:check && npm run genai:check && npm run roadmap:check && npm run validate:genai && npm run validate:roadmaps && npm run validate:seo && npm run validate:locations",
    "roadmap:sync": "node scripts/sync-course-roadmaps.mjs",
    "roadmap:check": "node scripts/sync-course-roadmaps.mjs --check",
    "validate:roadmaps": "node scripts/validate-course-roadmaps.mjs",
    "genai:sync": "node scripts/sync-genai-content.mjs",
    "genai:check": "node scripts/sync-genai-content.mjs --check",
    "validate:genai": "node scripts/validate-genai.mjs",
    "seo:smoke": "node scripts/seo-smoke.mjs",
    "seo:verify-indexing": "node scripts/verify-indexing.mjs",
    "prep:sync": "node scripts/sync-prep-content.mjs",
    "prep:check": "node scripts/sync-prep-content.mjs --check",
    "test": "vitest run",
    "test:performance": "playwright test --config playwright.performance.config.ts e2e/performance.spec.ts",
    "interview:sync": "node scripts/sync-interview-index.mjs",
    "interview:check": "node scripts/sync-interview-index.mjs --check"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.20.0",
    "lenis": "^1.3.27",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}

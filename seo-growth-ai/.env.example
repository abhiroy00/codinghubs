FREE_ONLY_MODE=true
ALLOW_PAID_APIS=false
MONTHLY_EXTERNAL_API_BUDGET_INR=0
ALLOW_CLOUD_PROVISIONING=false
ALLOW_AUTOMATIC_PAID_UPGRADE=false
SEO_PROFILE=lightweight
SEO_BIND=127.0.0.1
SEO_PORT=8765
OLLAMA_HOST=http://127.0.0.1:11435
OLLAMA_NO_CLOUD=1
SEO_LOCAL_MODEL=qwen3:0.6b
